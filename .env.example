# Book Factory — local development config
# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=book_factory
DB_USER=bookfactory
DB_PASS=change-me

# --- Gemini -----------------------------------------------------------------
# Google AI Studio project: "Book Factory"
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Ground the research pass in Google Search. Set to 0 if your key has no
# grounding quota; the worker also falls back automatically on a tool error.
GEMINI_USE_SEARCH=1

# minimal | low | medium | high. 3.5 Flash-Lite defaults to minimal.
GEMINI_THINKING_RESEARCH=medium
GEMINI_THINKING_WRITING=low

# --- Worker -----------------------------------------------------------------
# Absolute path to the python that has the deps installed.
PYTHON_BIN=/usr/bin/python3

# 1 = PHP fires off a one-shot worker right after you save a book, so you don't
# need a daemon running. 0 = you run `python3 ai/worker.py --loop` yourself.
AUTO_SPAWN_WORKER=1

# Where finished PDFs land (absolute, or relative to the project root).
STORAGE_PATH=storage/books

# --- App --------------------------------------------------------------------
APP_DEBUG=1

# URL prefix the app is served under ("" if at the document root)
APP_BASE=/bookfactory
